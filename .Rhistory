cancer, "_se.RData"
)
## ------------------------------------------------
## QUERY + DOWNLOAD (ONLY ONCE)
## ------------------------------------------------
if (file.exists(query_file)) {
message("Loading existing query")
load(query_file)   # loads object: query
} else {
message("Creating query and downloading data")
query <- download_tcga_data(
project_name = project_name,
data_category = data_category$transcriptome
)
dir.create("data/queries", recursive = TRUE, showWarnings = FALSE)
save(query, file = query_file)
}
## ------------------------------------------------
## EXPRESSION MATRIX (NO GDC ACCESS)
## ------------------------------------------------
if (file.exists(expr_file) && file.exists(se_file)) {
message("Expression matrix and SE found. Loading both.")
load(expr_file)  # loads expr_data
load(se_file)    # loads se
} else if (file.exists(expr_file) && !file.exists(se_file)) {
message("Expression matrix found. Creating SE only.")
load(expr_file)  # loads expr_data
se <- convert_to_se(expr_data)
save(se, file = se_file)
} else {
message("Expression data not found. Preparing from downloaded files.")
expr_data <- process_in_batches_with_query(query)
save(expr_data, file = expr_file)
filter_results <- sample_code_check(
counts_matrix = expr_data,
min_samples = 50,
keep_codes = c("01", "11")
)
expr_filtered <- filter_results$data_filtered
se <- convert_to_se(expr_filtered)
save(se, file = se_file)
}
## ------------------------------------------------
## DIFFERENTIAL EXPRESSION (FULL TRANSCRIPTOME)
## ------------------------------------------------
padj_threshold   <- config$analysis$padj_threshold
log2fc_threshold <- config$analysis$log2fc_threshold
deseq2_results <- run_deseq2_analysis(
data = se,
padj_threshold = padj_threshold,
log2fc_threshold = log2fc_threshold
)
edger_results <- run_edger_analysis(
data = se,
padj_threshold = padj_threshold,
log2fc_threshold = log2fc_threshold
)
limma_results <- run_limma_voom_analysis(
data = se,
padj_threshold = padj_threshold,
log2fc_threshold = log2fc_threshold
)
## ------------------------------------------------
## HISTONE FILTERING (RESULT STAGE)
## ------------------------------------------------
deseq2_histone <- deseq2_results$results[
rownames(deseq2_results$results) %in% ensembl_ids, ]
edger_histone <- edger_results$results[
rownames(edger_results$results) %in% ensembl_ids, ]
limma_histone <- limma_results$results[
rownames(limma_results$results) %in% ensembl_ids, ]
## ------------------------------------------------
## METHOD COMPARISON (HISTONE ONLY)
## ------------------------------------------------
consensus <- compare_de_methods(
deseq2_res = deseq2_histone,
edger_res  = edger_histone,
limma_res  = limma_histone,
histone_ensembl = ensembl_ids,
padj_threshold = padj_threshold
)
## ------------------------------------------------
## SAVE RESULTS
## ------------------------------------------------
dir.create("results/tables", recursive = TRUE, showWarnings = FALSE)
write.csv(consensus,
paste0("results/tables/", cancer, "_consensus.csv"),
row.names = FALSE)
## ------------------------------------------------
## QC PCA (diagnostic only)
## ------------------------------------------------
create_qc_plots(
dds = deseq2_results$dds,
output_dir = paste0("results/figures/", cancer, "_qc")
)
## ------------------------------------------------
## VOLCANO (FULL TRANSCRIPTOME)
## ------------------------------------------------
p <- plot_volcano_full(
de_results = deseq2_results,
title = paste0(cancer, " – Differential Expression")
)
ggsave(
paste0("results/figures/", cancer, "_volcano.pdf"),
plot = p,
width = 7,
height = 6
)
message("========== Finished ", cancer, " ==========")
}
