library(TCGAbiolinks)
library(survival)
library(survminer)
library(dplyr)
# 1. Clinical data indir
clinical <- GDCquery_clinic("TCGA-STAD", "clinical")
# 2. Expression data (daha önce indirdiğiniz DESeq2 normalized counts)
# Eğer yoksa:
expr_query <- GDCquery(
project = "TCGA-STAD",
data.category = "Transcriptome Profiling",
data.type = "Gene Expression Quantification",
workflow.type = "STAR - Counts"
)
normalized_counts <- readRDS("~/Desktop/GRADUATION PROJECT /luad_repo/results/STAD/normalized_counts.rds")
h2afy2_expr <- norm_counts["ENSG00000101542", ] # H2AFY2 Ensembl ID
# Veya gene symbol ile:
h2afy2_expr <- assay(expr_data)[rowData(expr_data)$gene_name == "H2AFY2", ]
load("~/Desktop/GRADUATION PROJECT /luad_repo/data/processed/STAD_expression.RData")
# Veya gene symbol ile:
h2afy2_expr <- assay(expr_data)[rowData(expr_data)$gene_name == "H2AFY2", ]
h2afy2_expr <- norm_counts["ENSG00000101542", ] # H2AFY2 Ensembl ID
# Veya gene symbol ile:
h2afy2_expr <- assay(expr_data)[rowData(expr_data)$gene_name == "H2AFY2", ]
# Data tipine bakın
class(expr_data)
# Eğer "matrix" veya "data.frame" ise:
if (is.matrix(expr_data) || is.data.frame(expr_data)) {
# Direkt gene ismine göre filtreleyin
h2afy2_expr <- expr_data[rownames(expr_data) == "H2AFY2", ]
# Veya gene name column varsa:
h2afy2_expr <- expr_data[expr_data$gene_name == "H2AFY2", ]
}
# expr_data bir matrix olduğu için sadece rownames kullanacağız
# 1. Rownames'e bakın
head(rownames(expr_data))
# 2. H2AFY2 var mı kontrol edin
"H2AFY2" %in% rownames(expr_data)
# 3. Eğer varsa, ekspresyonu çıkarın
h2afy2_expr <- expr_data["H2AFY2", ]
# 1. Clinical data indir
clinical <- GDCquery_clinic("TCGA-STAD", "clinical")
# 2. H2AFY2 ekspresyonunu çıkar (expr_data zaten matrix)
# Önce rownames kontrol
if ("H2AFY2" %in% rownames(expr_data)) {
h2afy2_expr <- expr_data["H2AFY2", ]
} else if ("ENSG00000101542" %in% rownames(expr_data)) {
h2afy2_expr <- expr_data["ENSG00000101542", ]
} else {
stop("H2AFY2 bulunamadı! Rownames'lere bakın: head(rownames(expr_data))")
}
# 3. Sample ID'leri düzenle
sample_ids <- colnames(expr_data)
patient_ids <- substr(sample_ids, 1, 12)
# 4. Expression data frame oluştur
h2afy2_df <- data.frame(
patient = patient_ids,
H2AFY2_expression = as.numeric(h2afy2_expr)
)
# 5. Clinical data ile birleştir
clinical_clean <- clinical %>%
mutate(patient = submitter_id)
combined <- h2afy2_df %>%
left_join(clinical_clean, by = "patient") %>%
filter(!is.na(days_to_death) | !is.na(days_to_last_follow_up)) %>%
mutate(
# Survival time
OS_time = ifelse(!is.na(days_to_death),
days_to_death,
days_to_last_follow_up),
# Event (1=death, 0=censored)
OS_status = ifelse(!is.na(days_to_death), 1, 0),
# Grupla (median)
H2AFY2_group = ifelse(H2AFY2_expression > median(H2AFY2_expression, na.rm=TRUE),
"High", "Low")
) %>%
filter(OS_time > 0)  # Negatif/sıfır zamanları çıkar
# 6. Kaplan-Meier
fit <- survfit(Surv(OS_time, OS_status) ~ H2AFY2_group, data = combined)
# 7. Plot
p <- ggsurvplot(
fit,
data = combined,
pval = TRUE,
conf.int = TRUE,
risk.table = TRUE,
xlab = "Time (days)",
ylab = "Overall Survival Probability",
title = "MACROH2A2 Expression and Overall Survival in STAD",
legend.title = "MACROH2A2",
legend.labs = c("High", "Low"),
palette = c("#E74C3C", "#3498DB")
)
print(p)
# 8. Log-rank test
survdiff(Surv(OS_time, OS_status) ~ H2AFY2_group, data = combined)
# 9. Kaydet
ggsave("KM_MACROH2A2_STAD.pdf", plot = p$plot, width = 8, height = 6)
# 10. Sample size kontrol
table(combined$H2AFY2_group)
library(survival)
library(survminer)
# Ki67 ekspresyonu ekle (MKI67 gene)
ki67_expr <- norm_counts["ENSG00000148773", ] # MKI67 Ensembl ID
combined_full <- combined %>%
mutate(
Ki67_expression = as.numeric(ki67_expr[match(patient, substr(names(ki67_expr), 1, 12))]),
age = as.numeric(age_at_diagnosis) / 365.25, # Yıl cinsine çevir
stage = factor(ajcc_pathologic_stage),
grade = factor(tumor_grade)
)
# 2. Univariate Cox (her değişken tek başına)
uni_vars <- c("H2AFY2_expression", "Ki67_expression", "age", "stage", "grade")
uni_results <- lapply(uni_vars, function(var) {
formula <- as.formula(paste("Surv(OS_time, OS_status) ~", var))
cox_model <- coxph(formula, data = combined_full)
summary(cox_model)
})
names(uni_results) <- uni_vars
# Sonuçları tablo olarak göster
lapply(uni_results, function(x) {
data.frame(
HR = x$conf.int[1],
HR_lower = x$conf.int[3],
HR_upper = x$conf.int[4],
p_value = x$coefficients[5]
)
})
# 3. Multivariate Cox Regression
multi_cox <- coxph(
Surv(OS_time, OS_status) ~
H2AFY2_expression +
Ki67_expression +
age +
stage +
grade,
data = combined_full
)
# Sonuçlar
summary(multi_cox)
# Forest plot
ggforest(multi_cox, data = combined_full)
# Kaydet
pdf("Cox_Forest_Plot.pdf", width = 10, height = 6)
library(survival)
library(survminer)
library(dplyr)
# Combined data'yı kontrol et
summary(combined_full)
# Eksik değerleri kontrol et
colSums(is.na(combined_full))
# Sonsuz değerleri kontrol et
sapply(combined_full, function(x) sum(is.infinite(x)))
# Temiz data oluştur
combined_clean <- combined_full %>%
filter(
OS_time > 0,                           # Pozitif survival time
!is.na(OS_time),                       # Survival time mevcut
!is.na(OS_status),                     # Event status mevcut
!is.na(H2AFY2_expression),             # Gene expression mevcut
!is.infinite(H2AFY2_expression),       # Sonsuz değil
!is.na(age),                           # Age mevcut
age > 0, age < 100                     # Makul age range
) %>%
# Stage ve grade'i simplify et
mutate(
stage_simplified = case_when(
grepl("Stage I", stage, ignore.case = TRUE) ~ "I-II",
grepl("Stage II", stage, ignore.case = TRUE) ~ "I-II",
grepl("Stage III", stage, ignore.case = TRUE) ~ "III-IV",
grepl("Stage IV", stage, ignore.case = TRUE) ~ "III-IV",
TRUE ~ NA_character_
),
grade_simplified = case_when(
grade %in% c("G1", "G2") ~ "Low",
grade %in% c("G3", "G4") ~ "High",
TRUE ~ NA_character_
)
) %>%
filter(!is.na(stage_simplified))  # Stage bilinmeyenleri çıkar
# Final check
nrow(combined_clean)
summary(combined_clean)
# Univariate Cox - H2AFY2
cox_h2afy2 <- coxph(Surv(OS_time, OS_status) ~ H2AFY2_expression,
data = combined_clean)
summary(cox_h2afy2)
# Univariate Cox - Age
cox_age <- coxph(Surv(OS_time, OS_status) ~ age,
data = combined_clean)
summary(cox_age)
# Univariate Cox - Stage
cox_stage <- coxph(Surv(OS_time, OS_status) ~ stage_simplified,
data = combined_clean)
# Stage dağılımına bakın
table(combined_clean$stage_simplified, useNA = "ifany")
# Orijinal stage'e de bakın
table(combined_clean$stage, useNA = "ifany")
# Kaç unique değer var?
length(unique(combined_clean$stage_simplified))
# 2. Stage kolonunu bul
stage_cols <- grep("stage", colnames(clinical), value = TRUE, ignore.case = TRUE)
cat("Stage kolonları:\n")
print(stage_cols)
# En yaygın: ajcc_pathologic_stage veya tumor_stage
# Hangisi dolu ona bakın
if ("ajcc_pathologic_stage" %in% colnames(clinical)) {
clinical <- clinical %>%
rename(stage_raw = ajcc_pathologic_stage)
} else if ("tumor_stage" %in% colnames(clinical)) {
clinical <- clinical %>%
rename(stage_raw = tumor_stage)
} else if ("clinical_stage" %in% colnames(clinical)) {
clinical <- clinical %>%
rename(stage_raw = clinical_stage)
} else {
# İlk stage kolonunu kullan
clinical <- clinical %>%
rename(stage_raw = !!stage_cols[1])
}
# 3. Stage dağılımına bak
cat("\nStage distribution (raw):\n")
print(table(clinical$stage_raw, useNA = "ifany"))
# 4. Stage'i kategorize et
clinical_clean <- clinical %>%
mutate(
patient = submitter_id,
# Stage simplification
stage_group = case_when(
grepl("Stage I$|Stage IA|Stage IB", stage_raw, ignore.case = TRUE) ~ "Early",
grepl("Stage II|Stage IIA|Stage IIB", stage_raw, ignore.case = TRUE) ~ "Early",
grepl("Stage III|Stage IIIA|Stage IIIB|Stage IIIC", stage_raw, ignore.case = TRUE) ~ "Advanced",
grepl("Stage IV|Stage IVA|Stage IVB", stage_raw, ignore.case = TRUE) ~ "Advanced",
TRUE ~ NA_character_
),
# Age
age = age_at_diagnosis / 365.25,  # Günden yıla
# Survival
OS_time = ifelse(!is.na(days_to_death), days_to_death, days_to_last_follow_up),
OS_status = ifelse(!is.na(days_to_death), 1, 0)
) %>%
filter(
!is.na(OS_time),
OS_time > 0,
!is.na(stage_group),  # Stage bilinmeyenleri çıkar
!is.na(age)
)
# 5. Kontrol
cat("\nStage distribution (simplified):\n")
print(table(clinical_clean$stage_group))
cat("\nSample size after filtering:", nrow(clinical_clean), "\n")
# 6. Expression data ile birleştir
h2afy2_df <- data.frame(
patient = substr(colnames(expr_data), 1, 12),
H2AFY2_expression = as.numeric(expr_data["H2AFY2", ])
)
# Her stage'i manuel olarak kategorize et
combined_clean <- combined_full %>%
filter(
OS_time > 0,
!is.na(OS_time),
!is.na(OS_status),
!is.na(H2AFY2_expression),
!is.na(age),
age > 0, age < 100
) %>%
mutate(
stage_simplified = case_when(
stage %in% c("Stage I", "Stage IA", "Stage IB") ~ "I-II",
stage %in% c("Stage II", "Stage IIA", "Stage IIB") ~ "I-II",
stage %in% c("Stage III", "Stage IIIA", "Stage IIIB", "Stage IIIC") ~ "III-IV",
stage %in% c("Stage IV", "Stage IVA", "Stage IVB") ~ "III-IV",
TRUE ~ NA_character_
)
) %>%
filter(!is.na(stage_simplified))
# Kontrol
cat("=== STAGE DISTRIBUTION (FIXED) ===\n")
print(table(combined_clean$stage_simplified))
# Cross-tabulation (doğrulama için)
print(table(combined_clean$stage, combined_clean$stage_simplified))
# Univariate Cox - Stage
cox_stage <- coxph(Surv(OS_time, OS_status) ~ stage_simplified,
data = combined_clean)
summary(cox_stage)
# Univariate Cox - H2AFY2
cox_h2afy2 <- coxph(Surv(OS_time, OS_status) ~ H2AFY2_expression,
data = combined_clean)
summary(cox_h2afy2)
# Univariate Cox - Age
cox_age <- coxph(Surv(OS_time, OS_status) ~ age,
data = combined_clean)
summary(cox_age)
# Multivariate Cox
multi_cox <- coxph(
Surv(OS_time, OS_status) ~
H2AFY2_expression +
age +
stage_simplified,
data = combined_clean
)
summary(multi_cox)
# HR tablosu
library(broom)
hr_table <- tidy(multi_cox, exponentiate = TRUE, conf.int = TRUE) %>%
select(term, estimate, conf.low, conf.high, p.value) %>%
mutate(
HR = sprintf("%.2f", estimate),
CI = sprintf("(%.2f - %.2f)", conf.low, conf.high),
P = ifelse(p.value < 0.001, "<0.001", sprintf("%.3f", p.value))
) %>%
select(Variable = term, `Hazard Ratio` = HR, `95% CI` = CI, `P-value` = P)
print(hr_table)
# Kaydet
write.csv(hr_table, "multivariate_cox_STAD.csv", row.names = FALSE)
# Stage I-II hastalar
early_stage <- combined_clean %>% filter(stage_simplified == "I-II")
fit_early <- survfit(
Surv(OS_time, OS_status) ~
ifelse(H2AFY2_expression > median(H2AFY2_expression), "High", "Low"),
data = early_stage
)
p_early <- ggsurvplot(
fit_early,
data = early_stage,
pval = TRUE,
title = "Early Stage (I-II): MACROH2A2 and Survival",
legend.title = "MACROH2A2",
legend.labs = c("High", "Low")
)
print(p_early)
# Stage III-IV hastalar
late_stage <- combined_clean %>% filter(stage_simplified == "III-IV")
fit_late <- survfit(
Surv(OS_time, OS_status) ~
ifelse(H2AFY2_expression > median(H2AFY2_expression), "High", "Low"),
data = late_stage
)
p_late <- ggsurvplot(
fit_late,
data = late_stage,
pval = TRUE,
title = "Advanced Stage (III-IV): MACROH2A2 and Survival",
legend.title = "MACROH2A2",
legend.labs = c("High", "Low")
)
print(p_late)
# Kaydet
pdf("KM_stratified_by_stage.pdf", width = 12, height = 6)
print(p_early$plot)
print(p_late$plot)
dev.off()
