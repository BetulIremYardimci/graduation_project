comparison <- deseq2_histone %>%
select(gene_name,
DESeq2_log2FC = log2FoldChange,
DESeq2_padj = padj,
DESeq2_sig = deseq2_sig) %>%
left_join(
wilcox_histone %>%
select(gene_name,
Wilcoxon_diff = median_diff,
Wilcoxon_padj = padj,
Wilcoxon_sig = significance),
by = "gene_name"
) %>%
mutate(
Concordance = case_when(
DESeq2_sig == "ns" & Wilcoxon_sig != "ns" ~ "⚠ Wilcoxon only",
DESeq2_sig != "ns" & Wilcoxon_sig == "ns" ~ "⚠ DESeq2 only",
DESeq2_sig != Wilcoxon_sig ~ "⚠ Different levels",
TRUE ~ "✓ Concordant"
)
) %>%
arrange(desc(Concordance))
return(comparison)
}
# --- Load data ---
norm_counts    <- readRDS("results/STAD/normalized_counts.rds")
vst_counts     <- readRDS("results/STAD/vst_counts.rds")
deseq2_histone <- read.csv("results/STAD/deseq2_histone.csv")
wilcox_histone <- read.csv("results/STAD/wilcoxon_histone.csv")
# --- Create method comparison summary ---
method_summary <- create_method_summary_table(deseq2_histone, wilcox_histone)
cat("\n=== DESeq2 vs Wilcoxon Summary ===\n")
print(method_summary)
# Save summary
write.csv(method_summary,
"results/STAD/method_comparison_summary.csv",
row.names = FALSE)
# --- Create output directory ---
plot_dir <- "results/STAD/plots"
dir.create(plot_dir, recursive = TRUE, showWarnings = FALSE)
# --- 1. Violin + Boxplot (Dual method) ---
p_violin_dual <- plot_histone_expression_dual("STAD", norm_counts,
deseq2_histone, wilcox_histone)
ggsave(paste0(plot_dir, "/histone_expression_violin_dual_method.jpeg"),
plot = p_violin_dual, width = 16, height = 10, dpi = 300,
device = "jpeg", bg = "white")
cat("\u2713 Saved: histone_expression_violin_dual_method.jpeg\n")
# --- 2. VST Boxplot (Dual method) ---
p_boxplot_vst_dual <- plot_histone_boxplot_vst_dual("STAD", vst_counts,
deseq2_histone, wilcox_histone)
ggsave(paste0(plot_dir, "/histone_expression_boxplot_vst_dual_method.jpeg"),
plot = p_boxplot_vst_dual, width = 16, height = 7, dpi = 300,
device = "jpeg", bg = "white")
cat("\u2713 Saved: histone_expression_boxplot_vst_dual_method.jpeg\n")
# --- 3. Print discrepancies ---
discrepancies <- method_summary %>%
filter(grepl("⚠", Concordance))
if (nrow(discrepancies) > 0) {
cat("\n⚠️ METHOD DISCREPANCIES DETECTED:\n")
print(discrepancies)
cat("\n📝 RECOMMENDATION FOR DISCUSSION:\n")
cat("These genes show different significance levels between DESeq2 and Wilcoxon.\n")
cat("Possible reasons:\n")
cat("  - DESeq2 is more conservative with unbalanced sample sizes\n")
cat("  - Wilcoxon is more robust to outliers and non-normality\n")
cat("  - MACROH2A2: DESeq2 may be underpowered due to 35 Normal vs 548 Tumor\n")
cat("  - Consider reporting both methods for transparency\n")
}
cat("\n✓ All dual-method plots saved to:", normalizePath(plot_dir), "\n")
